// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma/client"
}

generator zod {
  provider         = "zod-prisma-types"
  output           = "../src/generated/zod"
  prismaClientPath = "@prisma/client"
  useMultipleFiles = false
  createInputTypes = true
  createModelTypes = true
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  VENDOR
}

enum Status {
  PENDING
  ACCEPTED
  REJECTED
}

enum ProductUnit {
  PIECE
  PACKET
  BOTTLE
  LITRE
  ML
  KG
  GRAM
  DOZEN
}

enum RequestType {
  SKIP
  INCREASE
  DECREASE
}

enum Platform {
  ANDROID
  IOS
}

enum SubscriptionStatus {
  ACTIVE
  STOPPED
}

model User {
  id        String   @id @default(uuid())
  /// @zod.string.min(2, { message: "Name must be at least 2 characters long" })
  name      String
  /// @zod.string.regex(/^\+?[1-9]\d{1,14}$/, { message: "Invalid phone number format" })
  phone     String   @unique
  address   String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor          Vendor?           @relation("VendorIdRelation")
  vendorcustomers VendorCustomers[] @relation("CustomerIdRelation")
  pushToken       PushToken[]
}

model Vendor {
  id            String   @id @default(uuid())
  userId        String   @unique
  /// @zod.string.min(2,{message: "Business name must be at least 2 characters long"})
  businessName  String
  /// @zod.string.regex(/^\+?[1-9]\d{1,14}$/, { message: "Invalid phone number format" })
  businessPhone String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation("VendorIdRelation", fields: [userId], references: [id], onDelete: Cascade)

  product Product[]

  vendorcustomers VendorCustomers[]
}

model Product {
  id          String      @id @default(uuid())
  vendorId    String
  /// @zod.string.min(2,{message: "Product name must be of at least 2 characters"})
  productName String
  /// @zod.string.min(2, {message: "Product description must be of at leat 2 characters"})
  description String
  unit        ProductUnit
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  subscription CustomerSubscription[]
  request      Requests[]
}

model VendorCustomers {
  id            String   @id @default(uuid())
  vendorId      String
  /// @zod.string.regex(/^\+?[1-9]\d{1,14}$/, { message: "Invalid phone number format" })
  customerId    String
  customerPhone String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user   User   @relation("CustomerIdRelation", fields: [customerId], references: [id], onDelete: Cascade)

  subscription CustomerSubscription[]
  request      Requests[]

  @@unique([vendorId, customerId])
}

model CustomerSubscription {
  id               String              @id @default(uuid())
  vendorCustomerId String
  productId        String
  startDate        DateTime
  endDate          DateTime?
  dailyQuantity    Decimal             @db.Decimal(10, 2)
  /// Price per single unit of the product, entered by the customer at subscribe time.
  /// Revenue = delivered quantity (after skip/increase/decrease requests) x price.
  price            Decimal             @default(0) @db.Decimal(10, 2)
  status           SubscriptionStatus  @default(ACTIVE)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  vendorCustomers VendorCustomers @relation(fields: [vendorCustomerId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  requests Requests[]

  subscriptionHistory SubscriptionHistory[]

  prices SubscriptionPrice[]
}

/// Price history for a subscription. The vendor can change a customer's
/// per-unit price effective from a future date (next day, or the 1st of next
/// month), so revenue for any given day is priced with the row whose
/// effectiveFrom is the latest date on or before that day. This keeps revenue
/// already earned at the old price intact instead of retroactively repricing it.
/// Subscriptions created before this table existed have no rows and fall back
/// to CustomerSubscription.price.
model SubscriptionPrice {
  id             String   @id @default(uuid())
  subscriptionId String
  price          Decimal  @db.Decimal(10, 2)
  /// Midnight (00:00) of the first day this price applies to.
  effectiveFrom  DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscription CustomerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, effectiveFrom])
  @@index([subscriptionId, effectiveFrom])
}

/// Snapshot of a completed/stopped subscription, preserved so vendors can
/// review subscription history even after a customer unsubscribes.
model SubscriptionHistory {
  id             String             @id @default(uuid())
  subscriptionId String
  customerId     String
  customerName   String
  productId      String
  productName    String
  vendorId       String
  vendorName     String
  startDate      DateTime
  endDate        DateTime
  durationDays   Int
  status         SubscriptionStatus @default(STOPPED)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  subscription CustomerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([customerId])
  @@index([status])
}

model Requests {
  id                String      @id @default(uuid())
  vendorCustomerId  String
  productId         String
  subscriptionId    String
  type              RequestType @default(SKIP)
  /// @zod.string.min(2,{message: "Message should be at least 2 of 2 characters"})
  message           String
  start_date        DateTime
  end_date          DateTime
  requestedQuantity Decimal?    @db.Decimal(10, 2)
  status            Status      @default(PENDING)
  respondedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  vendorCustomers VendorCustomers @relation(fields: [vendorCustomerId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  subscription CustomerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model PushToken {
  id        String   @id @default(cuid())
  token     String   @unique
  platform  Platform
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

{
  "expo": {
    "name": "Customer Management",
    "slug": "customer-management",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "cleartextTrafficPermitted": true,
      "package": "com.vengeace.customermanagement"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos so you can set a shop photo for your profile."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3f51a10f-b27e-45f1-8e75-3003ca298f8f"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3f51a10f-b27e-45f1-8e75-3003ca298f8f"
    }
  }
}
